{
    "name": "@synbase.io/pi",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "turbo run build",
        "format": "biome format --write .",
        "lint": "biome check .",
        "clean": "turbo run clean",
        "typecheck": "turbo run typecheck",
        "dev": "JITI_TSCONFIG_PATHS=true pi -ne -ns -np -nc --no-themes -e ./packages/**/src/extension.ts --skill ./packages/**/skills --prompt-template ./packages/**/prompts"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.9.1"
        }
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^26.6.4",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "turbo": "^2.11.7",
        "typescript": "^6.0.3"
    }
}
